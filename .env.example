# Copy this file to .env.local and fill in the values. Never commit real values.
# Only values prefixed NEXT_PUBLIC_ reach the browser; everything here is server-only.

# --- Database (Supabase Postgres + pgvector) ---
# App connection: Supabase "Transaction pooler" connection string (port 6543)
DATABASE_URL=
# Migrations: Supabase "Session pooler" connection string (port 5432), used by drizzle-kit
DATABASE_URL_MIGRATE=
# Percent-encode special characters in the password: @ -> %40, # -> %23, / -> %2F, : -> %3A, ? -> %3F, % -> %25

# --- App ---
# Public base URL, e.g. http://localhost:3000 (used in Stripe and WhatsApp links)
APP_URL=
# Which milestones are switched on: 1 = M1 ... 5 = all. Unset means 0 in production, 5 in development.
RELEASE_STAGE=

# --- Supabase Auth (M1) ---
# Project Settings -> Data API URL, and API Keys -> publishable key. Never put the secret key here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# --- Email: Resend (M1) ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Stripe (M3) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ID of the "Verisavo Monthly" plan
STRIPE_PRICE_MONTHLY=

# --- WhatsApp Cloud API (M4) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Verisavo's WhatsApp number, digits only with country code (for wa.me links)
WHATSAPP_NUMBER=
# Name of the approved AUTHENTICATION template (copy-code button) that sends link codes, and its language.
# Leave empty until Meta approves it: users then send "LINK <code>" to us instead (decision D13).
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_OTP_TEMPLATE_LANG=en
# Only for local tests: a stand-in for https://graph.facebook.com
WHATSAPP_API_BASE=
# e.g. v23.0 or newer
WHATSAPP_GRAPH_VERSION=

# --- AI services, through the Vercel AI SDK. Server-only. ---
# Set a key for each service an admin may choose in Admin → AI settings.
# Answers: Claude, OpenAI or Gemini. Knowledge search: OpenAI or Gemini (Anthropic has no search/embedding model).
# Use API keys from each service's developer console, owned by the business and with a spending limit:
# console.anthropic.com, platform.openai.com, aistudio.google.com.
# Never a personal Claude Code / ChatGPT / Gemini app login.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
